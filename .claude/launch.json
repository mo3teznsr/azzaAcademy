{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd apps/api && exec bun src/index.ts"],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd apps/web && exec bun run dev -- --port 3005"],
      "port": 3005
    }
  ]
}
