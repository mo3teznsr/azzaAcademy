NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER@localhost:5432/azza

# Public URLs (CORS + links in emails)
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# better-auth
BETTER_AUTH_SECRET=change-me-to-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:4000

# Mail (nodemailer). Leave SMTP_HOST empty to log emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Azza <no-reply@example.com>"

# Firebase (push). Leave empty to disable push and log instead.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# LiveKit
LIVEKIT_URL=wss://YOUR-LIVEKIT-HOST
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# File storage (receipts): private S3 bucket behind CloudFront (Origin Access Control).
# Leave S3_BUCKET/CLOUDFRONT_URL empty in dev to store under apps/api/uploads. Required in production.
# Credentials use the default AWS chain: IAM role in AWS, or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY / AWS_PROFILE locally.
AWS_REGION=me-central-1
S3_BUCKET=
CLOUDFRONT_URL=
# e.g. S3_BUCKET=azza-uploads-prod  CLOUDFRONT_URL=https://dxxxxxxxxxxxx.cloudfront.net (or https://cdn.your-domain)

# Stripe (charges are always AED)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Apple In-App Purchase (iOS app sells seats only through IAP). Accepted environments, comma-separated:
# Production and/or Sandbox (TestFlight, App Review, sandbox testers). Production requires APPLE_APP_APPLE_ID
# (the numeric Apple ID in App Store Connect → App Information). Production deploy: APPLE_IAP_ENVIRONMENT=Production,Sandbox
APPLE_BUNDLE_ID=com.futuretech.azza
APPLE_IAP_ENVIRONMENT=Sandbox
APPLE_APP_APPLE_ID=

# App Store review demo accounts (comma-separated emails). These students can open the lobby and live room of any
# session in their batch at any time; when the session isn't live they get a private demo room (no host, no recording,
# real session untouched). Seed creates appreview@azza.academy (password from DEMO_REVIEWER_PASSWORD).
DEMO_REVIEWER_EMAILS=appreview@azza.academy
# Seed-only: reviewer password (12+ chars; random + printed once if empty) and a playable MP4 for its recordings.
DEMO_REVIEWER_PASSWORD=
DEMO_RECORDING_URL=

# Business rules
TEACHER_SHARE_PERCENT=60
EARNING_HOLD_DAYS=14
MIN_PAYOUT_AED=200
BANK_TRANSFER_HOLD_HOURS=48
VAT_PERCENT=5
