NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER@localhost:5432/azza

# Public URLs (CORS + links in emails)
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# better-auth
BETTER_AUTH_SECRET=change-me-to-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:4000

# Mail (nodemailer). Leave SMTP_HOST empty to log emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Azza <no-reply@example.com>"

# Firebase (push). Leave empty to disable push and log instead.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# LiveKit
LIVEKIT_URL=wss://YOUR-LIVEKIT-HOST
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Stripe (charges are always AED)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Business rules
TEACHER_SHARE_PERCENT=60
EARNING_HOLD_DAYS=14
MIN_PAYOUT_AED=200
BANK_TRANSFER_HOLD_HOURS=48
VAT_PERCENT=5
