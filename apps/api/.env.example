NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER@localhost:5432/azza

# Public URLs (CORS + links in emails)
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# better-auth
BETTER_AUTH_SECRET=change-me-to-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:4000
# Production: parent domain shared by web + API, e.g. .azza.academy (leave empty locally)
COOKIE_DOMAIN=
# Header your reverse proxy overwrites with the visitor IP (e.g. X-Real-IP behind nginx+Cloudflare).
# Leave empty when clients connect directly.
CLIENT_IP_HEADER=

# Sign in with Google (optional; the button shows only when both are set).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google ; JavaScript origin: <WEB_URL>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# iOS / Android OAuth client ids whose ID tokens the API accepts (native sign-in), comma-separated.
GOOGLE_NATIVE_CLIENT_IDS=

# Sign in with Apple (optional; the button shows only when all are set).
# Apple Developer > Identifiers > Services ID (Sign in with Apple on; domain = API host;
# Return URL = <BETTER_AUTH_URL>/api/auth/callback/apple). Keys > new key with Sign in with Apple (.p8).
APPLE_SIGNIN_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY_PATH=
# or inline, with literal \n for newlines
APPLE_SIGNIN_PRIVATE_KEY=

# Mail (nodemailer). Leave SMTP_HOST empty to log emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Azza <no-reply@example.com>"

# Firebase (push). Leave empty to disable push and log instead.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# LiveKit
LIVEKIT_URL=wss://YOUR-LIVEKIT-HOST
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# File storage (receipts): private S3 bucket behind CloudFront (Origin Access Control).
# Leave S3_BUCKET/CLOUDFRONT_URL empty in dev to store under apps/api/uploads. Required in production.
# Credentials use the default AWS chain: IAM role in AWS, or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY / AWS_PROFILE locally.
AWS_REGION=me-central-1
S3_BUCKET=
CLOUDFRONT_URL=
# e.g. S3_BUCKET=azza-uploads-prod  CLOUDFRONT_URL=https://dxxxxxxxxxxxx.cloudfront.net (or https://cdn.your-domain)

# Stripe (charges are always AED)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Teacher payouts through Stripe Connect (off unless stripe_connect). Key falls back to STRIPE_SECRET_KEY.
# Webhook: a Connect endpoint at /api/webhooks/payouts with payout.paid, payout.failed, payout.canceled, payout.updated.
PAYOUT_PROVIDER=none
STRIPE_PAYOUTS_SECRET_KEY=
STRIPE_PAYOUTS_WEBHOOK_SECRET=

# Tabby "pay in 4" for live-class seats (UAE). Offered only when the secret key and merchant code are set.
# Test keys (sk_test_/pk_test_) use the same base URL. Register the webhook once per key + merchant code:
#   POST https://api.tabby.ai/api/v1/webhooks  (Authorization: Bearer <secret key>, X-Merchant-Code: <code>)
#   { "url": "https://<api host>/api/webhooks/tabby", "header": { "title": "<TABBY_WEBHOOK_HEADER>", "value": "<TABBY_WEBHOOK_SECRET>" } }
TABBY_SECRET_KEY=
TABBY_PUBLIC_KEY=
TABBY_MERCHANT_CODE=
TABBY_WEBHOOK_SECRET=
TABBY_WEBHOOK_HEADER=X-Tabby-Webhook-Secret

# Adaptive streaming (HLS) of lesson videos through Bunny Stream (optional; lessons play the uploaded MP4 without it).
# bunny.net → Stream → add a library: enable 240p/360p/720p and "MP4 fallback"; copy the library id, the API key, the
# read-only API key (verifies webhooks) and the CDN hostname (vz-xxxx.b-cdn.net). Webhook URL:
#   https://<api host>/api/webhooks/bunny-stream
# Optional: turn on token authentication in the library's pull zone and set its key to sign playback URLs.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_READONLY_API_KEY=
BUNNY_STREAM_CDN_HOST=
BUNNY_STREAM_TOKEN_KEY=
VIDEO_TRANSCODE_ON_UPLOAD=true
# Hourly job sending older lesson videos (uploaded before streaming was set up), 5 at a time.
VIDEO_TRANSCODE_BACKFILL=false
# Offline lesson downloads play at most this many days before the app must re-check access online.
OFFLINE_DOWNLOAD_MAX_DAYS=30

# Apple In-App Purchase (iOS app sells seats only through IAP). Accepted environments, comma-separated:
# Production and/or Sandbox (TestFlight, App Review, sandbox testers). Production requires APPLE_APP_APPLE_ID
# (the numeric Apple ID in App Store Connect → App Information). Production deploy: APPLE_IAP_ENVIRONMENT=Production,Sandbox
APPLE_BUNDLE_ID=com.futuretech.azza
APPLE_IAP_ENVIRONMENT=Sandbox
APPLE_APP_APPLE_ID=

# App Store Connect API key: lets the API create and price the App Store products by itself (seat consumables and
# recorded-course subscriptions). Optional: without it nothing breaks and the sync reports "not configured".
# Needs APPLE_APP_APPLE_ID above. Keep the .p8 file OUTSIDE the repo. See docs/STORE_RELEASE.md §2c.
# ASC_ISSUER_ID=
# ASC_KEY_ID=
# ASC_PRIVATE_KEY_PATH=/secure/path/AuthKey_XXXXXXXXXX.p8
# Or inline instead of a path (literal \n for newlines):
# ASC_PRIVATE_KEY=

# App Store review demo accounts (comma-separated emails). These students can open the lobby and live room of any
# session in their batch at any time; when the session isn't live they get a private demo room (no host, no recording,
# real session untouched). Seed creates appreview@azza.academy (password from DEMO_REVIEWER_PASSWORD).
DEMO_REVIEWER_EMAILS=appreview@azza.academy
# Seed-only: reviewer password (12+ chars; random + printed once if empty) and a playable MP4 for its recordings.
DEMO_REVIEWER_PASSWORD=
DEMO_RECORDING_URL=

# Business rules
TEACHER_SHARE_PERCENT=60
EARNING_HOLD_DAYS=14
MIN_PAYOUT_AED=200
BANK_TRANSFER_HOLD_HOURS=48
VAT_PERCENT=5
