# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end


# WebRTC-SDK sometimes lands in Pods/ as an empty, nested folder (no WebRTC.xcframework), which breaks the build
# with "'WebRTC/WebRTC.h' file not found". Repair it from the CocoaPods cache in pre_install: that runs after the
# download but before the Pods project and xcconfigs are generated, so CocoaPods still sees the xcframework and adds
# its FRAMEWORK_SEARCH_PATHS (a post_install repair is too late and leaves flutter_webrtc without them).
def repair_webrtc_pod
  dir = File.join(__dir__, 'Pods', 'WebRTC-SDK')
  return if !Dir.exist?(dir) || Dir.exist?(File.join(dir, 'WebRTC.xcframework'))
  cached = Dir.glob(File.expand_path('~/Library/Caches/CocoaPods/Pods/Release/WebRTC-SDK/*/WebRTC.xcframework')).max_by { |p| File.mtime(p) }
  raise '[!] Pods/WebRTC-SDK is empty and no cached WebRTC.xcframework exists: delete Pods/WebRTC-SDK and run pod install' unless cached
  FileUtils.rm_rf(Dir.glob(File.join(dir, '{*,.DS_Store}')))
  FileUtils.cp_r(cached, dir)
  puts "Repaired Pods/WebRTC-SDK from #{cached}"
end

pre_install do |_installer|
  repair_webrtc_pod
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # See Shims/DeviceInfoVisionShim.h (Xcode 26.0.x SDK lacks isiOSAppOnVision).
    next unless target.name == 'device_info_plus'
    target.build_configurations.each do |config|
      config.build_settings['OTHER_CFLAGS'] = ['$(inherited)', '-include', '${PODS_ROOT}/../Shims/DeviceInfoVisionShim.h']
    end
  end
end
